function(lotui_add_hardware_sensor_sources target)
    set(source_dir "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
    find_package(Threads REQUIRED)
    target_link_libraries(${target} PRIVATE Threads::Threads)
    if(WIN32)
        target_sources(${target} PRIVATE "${source_dir}/sensors_windows.cpp")
        target_link_libraries(${target} PRIVATE winhttp)
    elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux")
        target_sources(${target} PRIVATE "${source_dir}/sensors_linux.cpp")
        if(CMAKE_DL_LIBS)
            target_link_libraries(${target} PRIVATE ${CMAKE_DL_LIBS})
        endif()
    else()
        target_sources(${target} PRIVATE "${source_dir}/sensors_unavailable.cpp")
    endif()
endfunction()
