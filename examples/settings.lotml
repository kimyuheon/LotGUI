<?xml version="1.0" encoding="UTF-8"?>
<Column id="settingsDialog"
        spacing="12"
        padding="20"
        background="#151A24"
        cornerRadius="12">
  <Label id="title"
         text="프로젝트 설정"
         fontSize="22"
         fontWeight="600"
         color="#F2F5FFFF" />

  <Label text="LotML과 C++ 코드는 같은 WidgetTree를 만듭니다."
         color="#B9C2D0FF" />

  <Row spacing="8" mainAlign="end">
    <Button id="cancelButton"
            text="취소"
            width="96"
            onClick="cancel" />
    <Button id="saveButton"
            text="저장"
            width="96"
            onClick="save" />
  </Row>
</Column>
