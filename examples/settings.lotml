<?xml version="1.0" encoding="UTF-8"?>
<Column id="settingsDialog"
        spacing="12"
        padding="20"
        background="#151A24"
        cornerRadius="12">
  <Label id="title"
         text="프로젝트 설정"
         fontSize="22"
         fontWeight="600"
         color="#F2F5FFFF" />

  <Label text="LotML과 C++ 코드는 같은 WidgetTree를 만듭니다."
         color="#B9C2D0FF" />

  <TextField id="projectName"
             text="새 프로젝트"
             onChanged="settingsChanged"
             onSubmitted="save" />

  <Checkbox id="snapToGrid"
            text="격자에 맞춤"
            checked="true"
            onChanged="settingsChanged" />

  <Row spacing="12" crossAlign="center">
    <Label text="격자 크기" minWidth="100" />
    <NumericInput id="gridSize"
                  value="10"
                  minimum="0.5"
                  maximum="100"
                  step="0.5"
                  decimalPlaces="1"
                  onChanged="settingsChanged" />
  </Row>

  <Row spacing="8" mainAlign="end">
    <Button id="cancelButton"
            text="취소"
            width="96"
            onClick="cancel" />
    <Button id="saveButton"
            text="저장"
            width="96"
            onClick="save" />
  </Row>
</Column>
