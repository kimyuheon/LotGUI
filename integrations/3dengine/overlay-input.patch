+void setExternalOverlayInputCallback(
+    CAD_OverlayInputFn callback,
+    void* user) noexcept {
+    g_inputCallback = callback;
+    g_inputUser = callback ? user : nullptr;
+    g_captureFlags = 0;
+}
+
+void updateExternalOverlayInput(
+    const CAD_OverlayPointerInfo& pointer) noexcept {
+    if (!g_inputCallback) {
+        return;
+    }
+    try {
+        g_captureFlags = g_inputCallback(&pointer, g_inputUser) &
+            (CAD_OVERLAY_CAPTURE_POINTER | CAD_OVERLAY_CAPTURE_KEYBOARD);
+    } catch (const std::exception& error) {
+        std::cerr << "[overlay] input callback failed: " << error.what()
+                  << std::endl;
+        g_captureFlags = 0;
+    } catch (...) {
+        std::cerr << "[overlay] input callback failed: unknown exception"
+                  << std::endl;
+        g_captureFlags = 0;
+    }
+}
+
 unsigned int externalOverlayCaptureFlags() noexcept {
