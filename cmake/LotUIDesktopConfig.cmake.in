@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@LOTUI_BUILD_VULKAN_RENDERER@)
    find_dependency(Vulkan)
endif()
if(UNIX AND NOT APPLE)
    find_dependency(X11)
endif()
if(@LOTUI_BUILD_FREETYPE_TEXT@)
    find_dependency(Freetype 2.14)
    find_dependency(harfbuzz 14 CONFIG)
    if(NOT TARGET harfbuzz::harfbuzz AND TARGET harfbuzz)
        add_library(harfbuzz::harfbuzz ALIAS harfbuzz)
    endif()
endif()
if(@LOTUI_BUILD_DECLARATIVE_UI@)
    find_dependency(tinyxml2 11 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/LotUIDesktopTargets.cmake")
check_required_components(LotUI)
