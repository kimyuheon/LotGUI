{
  "name": "lotml-designer",
  "displayName": "LotUI Designer",
  "description": "Visual editor and Vulkan preview for LotUI LotML layouts",
  "version": "0.1.1",
  "publisher": "lotgui",
  "license": "MIT",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other", "Programming Languages"],
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Native preview runs only in trusted workspaces."
    }
  },
  "contributes": {
    "languages": [
      { "id": "lotml", "aliases": ["LotML"], "extensions": [".lotml"], "configuration": "./language-configuration.json" }
    ],
    "grammars": [
      { "language": "lotml", "scopeName": "text.xml.lotml", "path": "./lotml.tmLanguage.json" }
    ],
    "customEditors": [
      {
        "viewType": "lotgui.lotmlDesigner",
        "displayName": "LotUI Designer",
        "selector": [{ "filenamePattern": "*.lotml" }],
        "priority": "option"
      }
    ],
    "commands": [
      { "command": "lotgui.openDesigner", "title": "LotUI: Open Designer" },
      { "command": "lotgui.newLayout", "title": "LotUI: New LotML Layout" }
    ],
    "menus": {
      "explorer/context": [
        { "command": "lotgui.openDesigner", "when": "resourceExtname == .lotml", "group": "navigation" }
      ]
    },
    "configuration": {
      "title": "LotUI Designer",
      "properties": {
        "lotgui.previewExecutable": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "description": "Absolute path to the built lotml_preview executable. Leave blank to search the workspace build folders."
        }
      }
    }
  }
}
